"use client"

import { useMemo, useState } from "react"
import { useQuery, useQueryClient } from "@tanstack/react-query"
import { useSearchParams } from "react-router-dom"
import { Copy, Eye, FilePlus2, Layers, ListChecks, Loader2, Lock, Pencil, Plus } from "lucide-react"
import { PageHeader } from "@/components/layout/page-header"
import { Badge } from "@/components/ui/badge"
import { Button } from "@/components/ui/button"
import { Dialog, DialogContent, DialogFooter, DialogHeader, DialogTitle } from "@/components/ui/dialog"
import { Input } from "@/components/ui/input"
import { Label } from "@/components/ui/label"
import { useToast } from "@/components/ui/use-toast"
import { api, timeAgo } from "@/lib/api"
import { useI18n } from "@/lib/i18n"
import { cn } from "@/lib/utils"
import { CollectorPreview } from "./collector-preview"
import { mapFields, mapSections, type ApiForm } from "./types"
import { FormWorkbench } from "./wizard"

type DialogMode = "create" | "clone"

function statusKey(status: string): string {
  if (status === "published") return "status.published"
  if (status === "archived") return "status.archived"
  return "status.draft"
}

function FormCard({
  form,
  onOpen,
  onDuplicate,
  onView,
  onDelete,
}: {
  form: ApiForm
  onOpen: () => void
  onDuplicate: () => void
  onView: () => void
  onDelete: () => void
}) {
  const { t } = useI18n()
  const editable = form.publication_status === "draft"
  return (
    <div className="flex flex-col rounded-2xl border border-border/70 bg-card p-5 shadow-sm transition-shadow hover:shadow-md">
      <div className="flex items-start justify-between gap-3">
        <div className="min-w-0">
          <h3 className="truncate text-[1rem] font-bold text-foreground">{form.burmese_title}</h3>
          {form.english_title ? (
            <p className="truncate text-[0.8rem] text-muted-foreground">{form.english_title}</p>
          ) : null}
        </div>
        <Badge
          variant="outline"
          className={cn(
            "shrink-0 rounded-full text-[0.6rem] font-semibold",
            form.publication_status === "published"
              ? "border-transparent bg-[var(--success)]/12 text-[var(--success)]"
              : form.publication_status === "archived"
                ? "border-transparent bg-muted text-muted-foreground"
                : "border-transparent bg-[var(--warning)]/12 text-[var(--warning)]",
          )}
        >
          {t(statusKey(form.publication_status))}
        </Badge>
      </div>
      <p className="mt-1 font-mono text-[0.7rem] text-muted-foreground">
        {form.form_id} · {t("formBuilder.version")} v{form.version_number}
      </p>
      <p className="mt-1 font-mono text-[0.7rem] text-muted-foreground">
        {t("formBuilder.lastUpdated")}: {timeAgo(form.created_at)}
      </p>
      <div className="mt-4 flex flex-wrap items-center gap-4 text-[0.78rem] text-muted-foreground">
        <span className="inline-flex items-center gap-1.5">
          <Layers className="h-3.5 w-3.5" aria-hidden="true" />
          {form.form_sections.length} {t("formBuilder.sections")}
        </span>
        <span className="inline-flex items-center gap-1.5">
          <ListChecks className="h-3.5 w-3.5" aria-hidden="true" />
          {form.form_fields.length} {t("formBuilder.fields")}
        </span>
      </div>
      <p className="mt-2 text-[0.72rem] text-muted-foreground/80">
        {t("formBuilder.lastUpdated")}: {timeAgo(form.created_at)}
      </p>
      <div className="mt-5 flex flex-wrap items-center gap-2 border-t border-border/60 pt-4">
        {editable ? (
          <Button className="h-9 gap-1.5 rounded-lg" onClick={onOpen}>
            <Pencil className="h-3.5 w-3.5" /> {t("formBuilder.editDraft")}
          </Button>
        ) : (
          <Button variant="ghost" className="h-9 gap-1.5 rounded-lg" onClick={onView}>
            <Eye className="h-3.5 w-3.5" /> {t("common.preview")}
          </Button>
        )}
        <Button
          variant="ghost"
          size="sm"
          className="h-9 gap-1.5 rounded-lg"
          onClick={onDuplicate}
          title={t("formBuilder.duplicateHint")}
        >
          <Copy className="h-3.5 w-3.5" />
          {t("formBuilder.duplicate")}
        </Button>
        {editable && (
          <Button
            variant="destructive"
            size="sm"
            className="h-9 gap-1.5 rounded-lg"
            onClick={onDelete}
          >
            <Loader2 className="h-3.5 w-3.5 animate-spin" />
            {t("formBuilder.delete")}
          </Button>
        )}
      </div>
    </div>
  )
}

function FormMetaDialog({
  mode,
  source,
  open,
  onOpenChange,
  onDone,
}: {
  mode: DialogMode
  source: ApiForm | null
  open: boolean
  onOpenChange: (open: boolean) => void
  onDone: (form: ApiForm) => void
}) {
  const { t } = useI18n()
  const { toast } = useToast()
  const qc = useQueryClient()
  const [formId, setFormId] = useState("")
  const [titleMy, setTitleMy] = useState("")
  const [titleEn, setTitleEn] = useState("")
  const [description, setDescription] = useState("")
  const [busy, setBusy] = useState(false)

  // Re-seed the fields each time the dialog is (re)opened for a new target.
  const [seed, setSeed] = useState<string | null>(null)
  if (open) {
    const seedKey = `${mode}:${source?.form_id ?? ""}`
    if (seed !== seedKey) {
      setSeed(seedKey)
      if (mode === "clone" && source) {
        setFormId(`${source.form_id}-copy`)
        setTitleMy(`${source.burmese_title} (မူတူ)`)
        setTitleEn(source.english_title ? `${source.english_title} (copy)` : "")
        setDescription(source.description ?? "")
      } else {
        setFormId("")
        setTitleMy("")
        setTitleEn("")
        setDescription("")
      }
    }
  } else if (seed !== null) {
    setSeed(null)
  }

  const submit = async () => {
    if (!formId.trim() || !titleMy.trim()) return
    setBusy(true)
    try {
      const created =
        mode === "clone" && source
          ? await api.post<ApiForm>(`/api/v1/forms/${source.form_id}/clone`, {
              form_id: formId.trim(),
              burmese_title: titleMy.trim(),
              english_title: titleEn.trim() || null,
            })
          : await api.post<ApiForm>("/api/v1/forms", {
              form_id: formId.trim(),
              burmese_title: titleMy.trim(),
              english_title: titleEn.trim() || null,
              description: description.trim() || null,
            })
      qc.invalidateQueries({ queryKey: ["forms"] })
      toast({
        title: mode === "clone" ? t("fb.toast.cloneCreated") : t("fb.toast.formCreated"),
        description:
          mode === "clone"
            ? t("fb.toast.cloneCreatedDesc", { title: created.burmese_title })
            : t("fb.toast.formCreatedDesc", { title: created.burmese_title }),
        variant: "success",
      })
      onDone(created)
      onOpenChange(false)
    } catch (err) {
      toast({
        title: mode === "clone" ? t("fb.toast.cloneFailed") : t("fb.toast.formCreateFailed"),
        description: err instanceof Error ? err.message : t("fb.toast.tryAgain"),
        variant: "destructive",
      })
    } finally {
      setBusy(false)
    }
  }

  return (
    <Dialog open={open} onOpenChange={onOpenChange}>
      <DialogContent className="sm:max-w-lg">
        <DialogHeader>
          <DialogTitle>{mode === "clone" ? t("formBuilder.duplicate") : t("formBuilder.newForm")}</DialogTitle>
          <DialogDescription>
            {mode === "clone" ? t("formBuilder.duplicateHint") : t("formBuilder.noFormsHint")}
          </DialogDescription>
        </DialogHeader>
        <div className="space-y-4">
          <div>
            <Label htmlFor="fb-id" className="mb-1 block text-[0.78rem] font-semibold">
              {t("common.code")} <span className="text-[var(--destructive)]">*</span>
            </Label>
            <Input
              id="fb-id"
              value={formId}
              onChange={(e) => setFormId(e.target.value.toLowerCase().replace(/[^a-z0-9-_]/g, "-"))}
              placeholder="census-2027"
              className="h-10 rounded-lg font-mono text-[0.85rem]"
            />
            <p className="mt-1 text-[0.7rem] text-muted-foreground">{t("md.field.codeHint")}</p>
          </div>
          <div>
            <Label htmlFor="fb-my" className="mb-1 block text-[0.78rem] font-semibold">
              {t("common.nameBurmese")} <span className="text-[var(--destructive)]">*</span>
            </Label>
            <Input
              id="fb-my"
              value={titleMy}
              onChange={(e) => setTitleMy(e.target.value)}
              className="h-10 rounded-lg"
            />
          </div>
          <div>
            <Label htmlFor="fb-en" className="mb-1 block text-[0.78rem] font-semibold">
              {t("common.nameEnglish")}
            </Label>
            <Input
              id="fb-en"
              value={titleEn}
              onChange={(e) => setTitleEn(e.target.value)}
              className="h-10 rounded-lg"
            />
          </div>
          {mode === "create" && (
            <div>
              <Label htmlFor="fb-desc" className="mb-1 block text-[0.78rem] font-semibold">
                {t("common.description")}
              </Label>
              <Input
                id="fb-desc"
                value={description}
                onChange={(e) => setDescription(e.target.value)}
                className="h-10 rounded-lg"
              />
            </div>
          </div>
        </div>
        <DialogFooter>
          <Button variant="outline" className="rounded-xl border-border bg-card" onClick={() => onOpenChange(false)}>
            {t("common.cancel")}
          </Button>
          <Button
            className="rounded-xl"
            onClick={submit}
            disabled={busy || !formId.trim() || !titleMy.trim()}
          >
            {busy ? <Loader2 className="h-4 w-4 animate-spin" /> : <Plus className="h-4 w-4" />}
            {mode === "clone" ? t("formBuilder.duplicate") : t("formBuilder.newForm")}
          </Button>
        </DialogFooter>
      </DialogContent>
    </Dialog>
  )
}

function PreviewDialog({
  form,
  open,
  onOpenChange,
}: {
  form: ApiForm | null
  open: boolean
  onOpenChange: (open: boolean) => void
}) {
  const { t } = useI18n()
  const sections = useMemo(() => (form ? mapSections(form) : []), [form])
  const fields = useMemo(() => (form ? mapFields(form) : []), [form])
  return (
    <Dialog open={open} onOpenChange={onOpenChange}>
      <DialogContent className="max-h-[85vh] overflow-y-auto sm:max-w-2xl">
        <DialogHeader>
          <DialogTitle>{form?.burmese_title ?? t("common.preview")}</DialogTitle>
          <DialogDescription>{t("formBuilder.publishedFrozen")}</DialogDescription>
        </DialogHeader>
        <CollectorPreview sections={sections} fields={fields} previewLang="both" />
      </DialogContent>
    </Dialog>
  )
}

export function FormBuilderPage() {
  const { t } = useI18n()
  const [params, setParams] = useSearchParams()

  const selectedFormId = params.get("form") ?? ""
  const stepParam = Number(params.get("step") ?? "1")

  const formsQuery = useQuery({
    queryKey: ["forms"],
    queryFn: () => api.get<ApiForm[]>("/api/v1/forms"),
  })
  const forms = formsQuery.data ?? []

  const selected = forms.find((f) => f.form_id === selectedFormId) ?? null

  const [dialogMode, setDialogMode] = useState<DialogMode | null>(null)
  const [dialogSource, setDialogSource] = useState<ApiForm | null>(null)
  const [previewForm, setPreviewForm] = useState<ApiForm | null>(null)

  const openForm = (formId: string, step = 1) => {
    setParams({ form: formId, step: String(step) })
  }

  const backToPicker = () => setParams({})

  // Delete handler for FormCard
  const handleDelete = async (formId: string) => {
    if (!window.confirm(t("formBuilder.deleteConfirm"))) return
    try {
      await api.delete(`/api/v1/forms/${formId}`)
      toast({ title: t("formBuilder.delete"), description: t("formBuilder.deleted", { formId }) }, { variant: "success" })
      setParams({})
      setDialogMode(null)
      setDialogSource(null)
    } catch (err) {
      toast({
        title: t("formBuilder.deleteFailed"),
        description: err instanceof Error ? err.message : t("common.tryAgain"),
        variant: "destructive",
      })
    }
  }

  return (
    <div>
      <PageHeader
        title={t("formBuilder.title")}
        description={t("formBuilder.subtitle")}
        actions={
          !selected ? (
            <Button className="h-10 gap-2 rounded-xl" onClick={() => { setDialogSource(null); setDialogMode("create") }}>
              <FilePlus2 className="h-4 w-4" /> {t("formBuilder.newForm")}
            </Button>
          ) : null
        }
      />

      {selected ? (
        <FormWorkbench
          key={selected.form_id}
          form={selected}
          initialStep={stepParam}
          onBackToPicker={backToPicker}
        />
      ) : formsQuery.isLoading ? (
        <div className="flex items-center justify-center gap-2 rounded-2xl border border-border/70 bg-card py-20 text-[0.88rem] text-muted-foreground">
          <Loader2 className="h-4 w-4 animate-spin" /> {t("formBuilder.loading")}
        </div>
      ) : forms.length === 0 ? (
        <div className="rounded-2xl border border-dashed border-border/70 px-6 py-16 text-center">
          <Lock className="mx-auto mb-3 h-8 w-8 text-muted-foreground/40" aria-hidden="true" />
          <p className="text-[0.9rem] font-medium text-foreground">{t("formBuilder.noForms")}</p>
          <p className="mx-auto mt-1 max-w-md text-[0.82rem] text-muted-foreground">
            {t("formBuilder.noFormsHint")}
          </p>
          <Button
            className="mt-5 h-10 gap-2 rounded-xl"
            onClick={() => { setDialogSource(null); setDialogMode("create") }}
          >
            <FilePlus2 className="h-4 w-4" /> {t("formBuilder.newForm")}
          </Button>
        </div>
      ) : (
        <div className="space-y-4">
          <div className="flex items-center gap-2">
            <h2 className="text-[0.85rem] font-bold uppercase tracking-wide text-muted-foreground">
              {t("formBuilder.chooseForm")}
            </h2>
            <span className="h-px flex-1 bg-border" />
          </div>
          <p className="text-[0.82rem] text-muted-foreground">{t("formBuilder.chooseFormHint")}</p>
          <div className="grid gap-4 md:grid-cols-2 xl:grid-cols-3">
            {forms.map((form) => (
              <FormCard
                key={form.form_id}
                form={form}
                onOpen={() => openForm(form.form_id, 1)}
                onView={() => setPreviewForm(form)}
                onDuplicate={() => {
                  setDialogSource(form)
                  setDialogMode("clone")
                }}
                onDelete={() => handleDelete(form.form_id)}
              />
            ))
          </div>
        </div>
      )}
    </div>
  )
}