# Environment variables for the MOALI/LBVD Livestock Census Management System.
# Copy to `server/.env` and adjust. All values have safe development defaults,
# so a bare `uv run uvicorn app.main:app` works without a .env file.

# --- Environment ------------------------------------------------------------
# development | production  (production forces COOKIE_SECURE and refuses to
# bootstrap a default admin unless ADMIN_EMAIL/ADMIN_PASSWORD are set)
ENVIRONMENT=development
DEBUG=True

# --- Database ---------------------------------------------------------------
# MySQL 8 (see docker-compose.yml at repo root).
# When DATABASE_URL is unset it is derived from the MYSQL_* vars below.
DATABASE_URL=mysql+pymysql://moali:password@127.0.0.1:3306/livestock_census?charset=utf8mb4
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=livestock_census
MYSQL_USER=moali
MYSQL_PASSWORD=password
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306

# --- Security ---------------------------------------------------------------
# Set one fixed key for shared/multi-worker deployments. In development the app
# falls back to a per-process random key, which invalidates all sessions after
# every backend restart (re-login required).
SECRET_KEY=change-this-to-a-long-random-string
ALGORITHM=HS256

# Session cookie. httpOnly is always on; SameSite/secure follow CORS.
SESSION_COOKIE_NAME=moali_session
SESSION_MAX_AGE_SECONDS=604800
COOKIE_SAMESITE=lax
COOKIE_SECURE=False            # auto-true when ENVIRONMENT=production
COOKIE_DOMAIN=

# Authentication hardening
LOGIN_MAX_ATTEMPTS=10
LOGIN_LOCKOUT_SECONDS=300
PASSWORD_MIN_LENGTH=8

# Sliding-window per-IP rate limiting (in-memory, single worker)
RATE_LIMIT_PER_MINUTE=240
AUTH_RATE_LIMIT_PER_MINUTE=20

# --- Application ------------------------------------------------------------
APP_NAME=MOALI | LBVD Livestock Census Administration
APP_VERSION=1.0.0
# Frontend origin for CORS plus OAuth redirect callbacks (comma-separated).
FRONTEND_URL=http://localhost:5173
# Bootstrap admin created at startup when the users table is empty. In
# production the bootstrap is skipped unless these are explicitly provided.
ADMIN_EMAIL=admin@moali.gov.mm
ADMIN_PASSWORD=Admin@12345
ADMIN_NAME=System Administrator
ADMIN_NAME_EN=LBVD Census Admin

# --- Server -----------------------------------------------------------------
HOST=0.0.0.0
PORT=8000

# --- Email (unused until notification features are switched on) ---------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# --- Google OAuth (web "sign in with Google"; 501 until both are set) ---------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=